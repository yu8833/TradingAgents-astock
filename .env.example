# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# 第三方中转 / 代理网关地址（可选）。设置后所有模型请求走此地址，
# 方便国内通过中转访问 Claude / OpenAI 等。Web UI 侧边栏也可直接填写。
# 例: BACKEND_URL=https://your-proxy.com/v1
BACKEND_URL=

# --- 国内优化配置 ---
# pip 镜像源（加速依赖安装）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# 东方财富请求节流间隔（秒）。默认值1.0，单次分析可设为0.5，
# 批量多Agent任务建议设为1.5~2以避免IP被封。
EM_MIN_INTERVAL=1.0

# --- 邮箱配置（可选）---
# 用于发送分析报告到邮箱。收件邮箱必填，发件邮箱和授权码可在此或Web UI中配置。
# 收件邮箱会默认收到所有分析报告
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# --- 页面登录配置（可选）---
# 启用页面登录密码功能（默认关闭）
# ADMIN_AUTH_ENABLED=true
# 直接在.env中设置登录密码
# ADMIN_PASSWORD=your_password_here
